<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Frame Link</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Frame Link</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSCameraUsageDescription</key>
    <string>Frame Link uses this iPhone’s camera to take photos and share a live preview with a nearby iPhone.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Frame Link saves the photos you take to this iPhone’s Photos library.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Frame Link uses Photos access to find and delete the original when you delete a photo from Recent photos.</string>
    <key>NSMotionUsageDescription</key>
    <string>Frame Link uses motion data to show when your camera is level.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Frame Link discovers and connects to nearby iPhones to share a live camera preview without internet.</string>
    <key>NSBonjourServices</key><array><string>_framelink._tcp</string></array>
    <key>UILaunchScreen</key><dict/>
    <key>UIUserInterfaceStyle</key><string>Dark</string>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
    <key>UIApplicationSupportsIndirectInputEvents</key><true/>
</dict>
</plist>
